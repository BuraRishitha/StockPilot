# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/stockpilot

# JWT
JWT_ACCESS_SECRET=replace_with_strong_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace_with_different_strong_secret
JWT_REFRESH_EXPIRES=7d
JWT_REFRESH_EXPIRES_MS=604800000

# Email Verification / Reset Tokens
EMAIL_VERIFICATION_EXPIRES_MS=86400000
PASSWORD_RESET_EXPIRES_MS=900000

# Account Lock Policy
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MS=900000

# Nodemailer (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="StockPilot <no-reply@stockpilot.com>"
# Leave blank to verify SMTP connectivity without sending a message.
# Set this to a real, monitored mailbox only when intentionally testing delivery.
SMTP_TEST_RECIPIENT=

# Cookies
COOKIE_SECURE=false
